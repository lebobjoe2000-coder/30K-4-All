istics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b547-f1f7-3dc2-cacc"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="86e3-bb9e-f355-f1d2"/></constraints><entryLinks><entryLink id="5765-732e-6df2-6bd9" name="Combi-Bolter" hidden="false" type="selectionEntry" targetId="a498-c66f-9eb7-ca9a"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="de7b-6cc4-744f-8141"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f765-bc8a-21d9-ec12"/></constraints></entryLink><entryLink id="5ddc-88c7-b864-73e9" name="The Warsmith's Fist" hidden="false" type="selectionEntry" targetId="9a15-d081-5337-225e"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b667-8419-53f0-4c9a"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="56d7-76e0-dac2-d361"/></constraints></entryLink><entryLink id="18b7-b6fe-68af-7c19" name="Cataphractii Terminator Armour" hidden="false" type="selectionEntry" targetId="7c9b-b9ab-9a40-8eb5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="834b-bc2c-17f9-78b0"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2ec9-ca8a-6161-e8dc"/></constraints></entryLink><entryLink id="aa30-44c2-a0db-a053" name="Servo-Arm" hidden="false" type="selectionEntry" targetId="4168-fc85-8912-7188"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8a75-8fae-73e3-d42f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="72ab-653f-97b6-e8b2"/></constraints></entryLink><entryLink id="9184-d1d2-0ce0-6758" name="Cortex Controller" hidden="false" type="selectionEntry" targetId="2fda-455f-d34d-97e0"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e152-8847-bd77-1cf9"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ddab-9e95-8beb-7e3c"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="5adb-63b5-be7d-f339" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="14e2-1069-30be-3a7a" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="dff8-5f54-5799-0ec6" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="9378-4ee6-208f-5820" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="ef89-fc55-dc95-2fc1" name="heavy" hidden="false" targetId="9231-183c-b97b-63f9" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="149c-ca1e-15f1-2f66" name="Warlord: The Warsmith" publicationId="3970-79bb-bdc6-9599" page="115" hidden="false"><description>If chosen as Warlord, Barban Falk has The Warsmith and may not select another. Friendly Legiones Astartes (Iron Warriors) units from his Detachment within 12&quot; that fail a Morale or Pinning test may re-roll it (second result stands). The army gains an additional reaction in the Opposing Player's Movement phase while he has not been removed as a casualty.</description></rule><rule id="fd4a-810f-e522-2b67" name="Warsmith and Siege Breaker" publicationId="3970-79bb-bdc6-9599" page="115" hidden="false"><description>For the purposes of Rites of War and mandatory unit selections only, Barban Falk counts as a Warsmith and a Siege Breaker.</description></rule></rules><infoLinks><infoLink id="ba89-3d34-7e51-9cd7" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><infoLink id="dd15-9988-0962-7a4e" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="c9a0-965c-c29b-3732" name="Master of the Legion" hidden="f