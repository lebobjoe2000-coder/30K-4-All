d="true" id="61c5-18d5-d9cc-3fcf"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="a8b5-2266-7166-31d0" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="822e-29d1-d982-d34a" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="0592-2fbe-d93b-b61c" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="3360-8878-1f84-5366" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="da4a-e56f-1a6a-c901" name="corrupted" hidden="false" targetId="9055-7410-8ffd-b8e7" primary="false"/><categoryLink id="5209-9a89-f6c6-234b" name="psyker" hidden="false" targetId="6e0c-29ba-a445-8321" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="2ac8-72a2-f98e-6aeb" name="Fires of Faith" publicationId="3970-79bb-bdc6-9599" page="191" hidden="false"><description>Sor Talgron gains the Anathemata and Diabolism disciplines (see pages 106 and 309 of Liber Hereticus). He counts as an Esotericist and therefore allows any army with the Traitor allegiance that he is part of to select Ruinstorm Daemon units as described in the Esotericist entry on page 106 of Liber Hereticus.</description></rule><rule id="5a6d-9e62-8007-f045" name="Warlord: Enslaved by Darkness" publicationId="3970-79bb-bdc6-9599" page="191" hidden="false"><description>If chosen as Warlord he has Enslaved by Darkness and may not select another (see Liber Hereticus page 304).</description></rule></rules><infoLinks><infoLink id="fa42-43bf-f4a2-2eeb" name="Legiones Astartes (Word Bearers)" hidden="false" type="rule" targetId="21ba-24fc-3fad-00fe"/><infoLink id="bca6-a318-dcdc-24dc" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="28db-c29e-5e57-6adf" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="68e4-9ca3-a98f-1014" name="Traitor" hidden="false" type="rule" targetId="eff2-8b0e-21da-2f0d"/></infoLinks></selectionEntry><selectionEntry name="[LC] Retorka Mher Squad" type="unit" id="d6c9-7576-a750-053e" page="192" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="10e7-4404-761d-c500" name="elites" hidden="false" targetId="7aee-565f-b0ae-294e" primary="true"/><categoryLink id="b20b-cbfd-65dd-4fde" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="15"/></costs><selectionEntries><selectionEntry type="model" name="Retorka Mher" id="58d7-c17e-1c59-9fe7" page="192" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="0be6-3a30-8b02-90fe" name="Retorka Mher" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">4</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">5</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">5</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">4</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">5</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">3</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">9</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Corrupted)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="ab0c-4752-023b-d0ba"/><constraint type="max" value="5" field="selections" scope="parent" shared="true" id="9a38-f4c6-89c0-1520"/></constraints><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="95"/></costs><entryLinks><entryLink id="8cb2-48cc-f4da-faa9" name="Tartaros Terminator Armour" hidden="false" type="selectionEntry" targetId="f850-d0af-8663-ccac"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cdfb-2b2b-14b2-f229"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ab7b-b1bc-19c1-50ed"/></constraints></entryLink></entryLinks><selectionEntryGroups><selectionEntryGroup id="f19b-34af-27ba-d23c" name="Twin-Linked Boltspitter" hidden="false" collective="false" import="true" defaultSelectionEntryId="dff3-d1c2-8318-fef2"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6157-61b4-3472-40ce"/><constraint type="max" value="5" field="selections" scope="parent" shared="true" id="a819-43ca-2503-ac9d"/></constraints><entryLinks><entryLink id="dff3-d1c2-8318-fef2" name="Twin-Linked Boltspitter" hidden="false" type="selectionEntry" targetId="9221-5c79-0c8f-f3f3"/><entryLink id="1ed9-229f-f0ae-4a52" name="Heavy Flamer" hidden="false" type="selectionEntry" targetId="5507-b432-3b4c-df12"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink><entryLink id="d4c6-4ea9-c4e5-ebdc" name="Warpfire Blaster" hidden="false" type="selectionEntry" targetId="76c7-1d7c-206a-32a5"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink><entryLink id="b24b-0563-e040-a263" name="Warpfire Cannon" hidden="false" type="selectionEntry" targetId="2d54-6e68-4830-4ef3"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="25"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="d742-bcba-8ea6-0c15" name="Tainted Talon (two)" hidden="false" collective="false" import="true" defaultSelectionEntryId="3f5d-78ee-2701-2f46"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c037-a519-ecbf-46ce"/><constraint type="max" value="5" field="selections" scope="parent" shared="true" id="1a72-faca-4e4a-8c7e"/></constraints><entryLinks><entryLink id="3f5d-78ee-2701-2f46" name="Two Tainted Talons" hidden="false" type="selectionEntry" targetId="5986-86cf-f767-7f7b"/><entryLink id="517d-847a-b0e5-d5cf" name="Power Weapon" hidden="false" type="selectionEntry" targetId="d2db-7598-f55f-86fe"/><entryLink id="58de-de08-f55d-d2db" name="Power Fist" hidden="false" type="selectionEntry" targetId="768d-b89b-7328-d749"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="15"/></costs></entryLink><entryLink id="e982-0415-cda3-7d6a" name="Tainted Claw" hidden="false" type="selectionEntry" targetId="8415-e375-6940-2117"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="30"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="9813-178f-b550-92cf" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="02f7-3502-ce8f-61f1" name="corrupted" hidden="false" targetId="9055-7410-8ffd-b8e7" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="eeac-42eb-8549-0881" name="Weapon limits" publicationId="3970-79bb-bdc6-9599" page="192" hidden="false"><description>Warpfire Cannon: one model only (+25). Tainted Claw replaces one Boltspitter and one Tainted Talon on one model only (+30). Power Weapon/Power Fist replace a Tainted Talon on any model.</description></rule><rule id="5972-52da-a26e-78e2" name="Dedicated Transport" publicationId="3970-79bb-bdc6-9599" page="192" hidden="false"><description>A squad of any size may select a Legion Land Raider Spartan. No extra Force Organisation slot; points still paid.</description></rule></rules><infoLinks><infoLink id="149d-78ce-1dcc-cc93" name="Legiones Astartes (Word Bearers)" hidden="false" type="rule" targetId="21ba-24fc-3fad-00fe"/><infoLink id="e23a-dd18-55d5-13ad" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoL