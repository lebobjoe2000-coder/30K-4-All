ription></rule></rules><infoLinks><infoLink id="aeda-8ae1-6b34-84a0" name="Legiones Astartes (Sons of Horus)" hidden="false" type="rule" targetId="f4a2-e4ca-b8b2-35a1"/><infoLink id="8063-5cfb-9404-99f8" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="e3a1-d95d-c5e2-e2fd" name="Feel No Pain (X)" hidden="false" type="rule" targetId="ec46-ff29-32e0-c2aa"><modifiers><modifier type="set" field="name" value="Feel No Pain (5+)"/></modifiers></infoLink><infoLink id="76c0-d47a-73f8-f433" name="Counter-Attack (X)" hidden="false" type="rule" targetId="fd6d-2a76-10e0-936a"><modifiers><modifier type="set" field="name" value="Counter-Attack (1)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Hol Beloth" type="unit" id="f0b7-db79-df8d-e983" page="190" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="72b2-4f8d-1169-703e" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="8a4b-2546-7c8f-3dfd" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="215"/></costs><selectionEntries><selectionEntry type="model" name="Hol Beloth" id="6691-ab51-8d87-d4f2" page="190" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="b7a5-ec07-8192-875b" name="Hol Beloth" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">6</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">3</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">5</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">4</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Character, Corrupted, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="250a-4d08-df08-7aa8"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d79e-e37c-0a87-b434"/></constraints><entryLinks><entryLink id="6fdc-652f-02a6-a592" name="Warpfire Pistol" hidden="false" type="selectionEntry" targetId="a94d-1f53-2902-0237"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="377f-4c49-bbeb-7b3e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="82bd-4c12-f584-b93f"/></constraints></entryLink><entryLink id="45d8-cf8a-50f9-2d76" name="Power Fist" hidden="false" type="selectionEntry" targetId="768d-b89b-7328-d749"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="a9d9-fc8d-0de6-5fe9"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bb02-97cd-5e7b-03af"/></constraints></entryLink><entryLink id="d9a1-7179-2a54-0bc0" name="Artificer Armour" hidden="false" type="selectionEntry" targetId="583e-62cb-53f1-f952"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b211-1a49-a735-38f4"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ed16-3909-0cc5-bf76"/></constraints></entryLink><entryLink id="7a3f-2001-43ec-2d77" name="Iron Halo" hidden="false" type="selectionEntry" targetId="b081-bf3c-f43d-4bd5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f4f1-e109-a90e-b384"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3bea-0159-a17a-89df"/></constraints></entryLink><entryLink id="8ef7-2189-e02f-0d20" name="Tainted Blade" hidden="false" type="selectionEntry" targetId="e4fb-34d5-6565-b8c6"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6cd2-0e8a-ae69-41cd"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e9ec-9c00-db21-3305"/></constraints></entryLink><entryLink id="6bef-6a39-8696-0930" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="80bc-324e-8a56-e096"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d704-01e2-2390-1257"/></constraints></entryLink><entryLink id="472b-bb43-b63a-fa31" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="67be-d54a-ff7a-5295"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="edba-8c1e-7a66-fb50"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="b60c-ccbb-b122-e4dd" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="14a2-b849-c610-d584" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="1bf8-0de6-c6b6-b0be" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="25ff-04ed-65fb-b852" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="c13e-7e23-1943-f9e1" name="corrupted" hidden="false" targetId="9055-7410-8ffd-b8e7" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="82ac-f663-d0a0-3d2c" name="Master-Crafted Power Fist" publicationId="3970-79bb-bdc6-9599" page="190" hidden="false"><description>Hol Beloth's Power Fist has the Master-Crafted Special Rule.</description></rule><rule id="ef87-4a4b-9a6d-a7db" name="Hexapentic Ward" publicationId="3970-79bb-bdc6-9599" page="190" hidden="false"><description>Hol Beloth may ignore the first wound suffered during the game as a result of any failed Save, even if that wound would normally inflict Instant Death.</description></rule><rule id="f6a6-d70a-7147-669a" name="Goading to Slaughter" publicationId="3970-79bb-bdc6-9599" page="190" hidden="false"><description>So long as Hol Beloth is on the table and not Falling Back, once per game at the beginning of the Assault phase his controlling player can declare this ability. All models in the army with Legiones Astartes (Word Bearers) may set their Weapon Skill to 5 for the duration of the Assault phase.</description></rule><rule id="3c76-8ec8-d0f2-4745" name="Warlord: Exhortation of Battle" publicationId="3970-79bb-bdc6-9599" page="190" hidden="false"><description>If chosen as Warlord he has Exhortation of Battle and may not select another. Once per game, at the start of any of the Controlling Player's Assault Phases, you may declare Hol Beloth's Exhortations: until the end of the turn he and any unit he has joined gain +1 Weapon Skill. The army may make an additional Reaction during the opponent's Assault phase while he has not been removed as a casualty.</description></rule></rules><infoLinks><infoLink id="d8a0-c562-478f-23c2" name="Legiones Astartes (Word Bearers)" hidden="false" type="rule" targetId="21ba-24fc-3fad-00fe"/><infoLink id="b9a1-5496-7403-01cd" name="Traitor" hidden="false" type="rule" targetId="eff2-8b0e-21da-2f0d"/><infoLink id="ad73-1bf2-2e0f-f456" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="4fd5-95f9-8d91-a6d5" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/></infoLinks></selectionEntry><selectionEntry name="[LC] Sor Talgron" type="unit" id="3062-d1b9-c372-0912" page="191" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="2f34-0586-62ab-49e6" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="4a0a-3dfe-893e-2c40" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="175"/></costs><selectionEntries><selectionEntry type="model" name="Sor Talgron" id="d406-72b6-ca97-1d4a" page="191" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="e641-0772-da76-4252" name="Sor Talgron" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">6</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">3</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">5</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">4</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Character, Corrupted, Psyker, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f066-dd96-e83a-507c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4dcf-bf7b-1026-972c"/></constraints><entryLinks><entryLink id="0683-835b-7fc9-f459" name="Artificer Armour" hidden="false" type="selectionEntry" targetId="583e-62cb-53f1-f952"><constraints><constraint type="min" value="1" field="selections" scope=