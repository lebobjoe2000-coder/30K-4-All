e="1" field="selections" scope="parent" shared="true" id="7273-1b06-dbda-6337"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a6dd-a8bb-4ec8-0a8c"/></constraints></entryLink><entryLink id="c7d8-a586-f91d-df9e" name="Power Sword" hidden="false" type="selectionEntry" targetId="a3cd-aa97-a148-2309"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cddc-e82e-e561-2c6b"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1ac9-5bae-5f47-819e"/></constraints></entryLink><entryLink id="d3ec-dcbc-72f8-9140" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b1b0-2a6f-c869-3844"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e2e6-217c-1e17-15b2"/></constraints></entryLink><entryLink id="b4b4-b587-1bad-5ba6" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0c44-7661-1257-076e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dbbc-8cd6-b638-222d"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="5391-6749-99e5-9dd0" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="bf5c-a990-5f2d-6654" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="0765-f7fd-e9d1-8047" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="2c19-7a30-2f68-3fb3" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="5791-dac1-3868-6424" name="Every Door a New Horror" publicationId="3970-79bb-bdc6-9599" page="167" hidden="false"><description>Whilst Aeonid Thiel is locked in combat with an enemy unit that has the Corrupted or Daemon Unit Sub-type, he gains a 5+ Invulnerable Save.</description></rule><rule id="aa2b-7070-e8f1-3f4c" name="There's No Room for Honour Here" publicationId="3970-79bb-bdc6-9599" page="167" hidden="false"><description>Whenever an enemy model accepts a challenge issued by Aeonid Thiel or Thiel accepts a challenge, he may make a Shooting attack at his opponent with his Bolt Pistol before the combat begins. The Bolt Pistol gains Concussive (1) for that attack. Any wound inflicted is resolved before the combat begins.</description></rule><rule id="ef4b-c136-64d7-89d2" name="Distrusted By Our Own" publicationId="3970-79bb-bdc6-9599" page="167" hidden="false"><description>A unit with this Special Rule can never benefit from any positive modifiers to its Leadership from any friendly units, unless it is from a unit with the Brothers in Censure Special Rule, or from the effects of The Red Marked Rite of War. It may still use Aeonid Thiel's Leadership Characteristic, if he joins the unit.</description></rule><rule id="a5d7-6201-1aab-2a3d" name="Warlord: The Aegis of Wisdom" publicationId="3970-79bb-bdc6-9599" page="167" hidden="false"><description>If chosen as Warlord he has The Aegis of Wisdom and may not select another (see Liber Astartes page 292).</description></rule></rules><infoLinks><infoLink id="1057-3454-9fed-2257" name="Legiones Astartes (Ultramarines)" hidden="false" type="rule" targetId="519d-a6ed-f57f-3642"/><infoLink id="d6a4-e705-26a5-4093" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/><infoLink id="a6be-88e5-eda7-0e14" name="Stubborn" hidden="false" type="rule" targetId="7989-1f2c-a43d-82ae"/><infoLink id="38a9-645f-f73b-35e1" name="Preferred Enemy (X)" hidden="false" type="rule" targetId="37ab-d4db-891a-de8c"><modifiers><modifier type="set" field="name" value="Preferred Enemy (Legiones Astartes)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Red-Marked Squad" type="unit" id="2a88-84e7-a4be-55f8" page="168" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="dc0b-7340-b397-8fe4" name="elites" hidden="false" targetId="7aee-565f-b0ae-294e" primary="true"/><categoryLink id="fe08-c6c0-f35f-70b6" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="47"/></costs><selectionEntries><selectionEntry type="model" name="Red-Marked" id="9c8a-31aa-bb8f-2c31" page="168" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="1960-5215-1d65-0204" name="Red-Marked" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">2</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">2</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">8</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">3+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="4" field="selections" scope="parent" shared="true" id="3608-8e08-3e0c-7a32"/><constraint type="max" value="14" field="selections" scope="parent" shared="true" id="5a41-898e-2666-a28a"/></constraints><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="22"/></costs><entryLinks><entryLink id="2cad-d6b4-201b-d468" name="Power Armour" hidden="false