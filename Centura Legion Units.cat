 hidden="false" type="selectionEntry" targetId="2612-6c89-dbd3-4f96"/><entryLink id="7549-4eab-9317-8547" name="Encarmine Axe" hidden="false" type="selectionEntry" targetId="2d59-c2b1-8015-8953"/><entryLink id="647b-2088-b03e-ea27" name="Perdition Weapon" hidden="false" type="selectionEntry" targetId="d93a-033b-233b-453a"/><entryLink id="08ad-83ca-a2bb-317b" name="Power Fist" hidden="false" type="selectionEntry" targetId="768d-b89b-7328-d749"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="c0f6-6f86-237f-f034" name="Replace Bloodshard Boltgun with" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="7bbb-b900-f796-549c"/></constraints><entryLinks><entryLink id="1093-1751-0a7e-d8b0" name="Plasma Pistol" hidden="false" type="selectionEntry" targetId="717f-cf0a-1593-4bd8"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink><entryLink id="d217-cc14-5e0e-f673" name="Inferno Pistol" hidden="false" type="selectionEntry" targetId="3f00-1930-8fcb-41c5"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="453e-5c7e-3c7d-917b" name="One model may take a" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="75f2-613a-0d3a-01e2"/></constraints><entryLinks><entryLink id="88a5-7ff3-593a-5dc1" name="Legion Standard" hidden="false" type="selectionEntry" targetId="7e13-cc1f-6bd7-7ac6"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="cce6-514a-eccd-99b0" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="95bb-2a32-2719-15ac" name="Sanguinary Retinue" publicationId="3970-79bb-bdc6-9599" page="147" hidden="false"><description>A Sanguinary Guard may only be included in a Detachment if selected as a Retinue Squad, in a Detachment including at least one model with both Master of the Legion and Legiones Astartes (Blood Angels) that is either Sanguinius or is equipped with a Legion Warhawk Jump Pack. That model must be the squad's leader and may not voluntarily leave. If the leader is deployed in a Deep Strike Assault the unit must be set up in Deep Strike Assault with them. Uses no Force Organisation slot and is part of the same unit as its leader. 0-1.</description></rule><rule id="4910-bea4-103d-e9a5" name="Artisans of War" publicationId="3970-79bb-bdc6-9599" page="147" hidden="false"><description>When a model with this Special Rule fights in the Assault phase, it may re-roll all To Hit rolls of 1.</description></rule><rule id="28a2-0bae-3f91-6c4d" name="Encarmine Weapons" publicationId="3970-79bb-bdc6-9599" page="147" hidden="false"><description>Encarmine Swords and Axes count as 'Power' weapons for those rules that affect such weapons.</description></rule></rules><infoLinks><infoLink id="ef47-6134-e583-804b" name="Legiones Astartes (Blood Angels)" hidden="false" type="rule" targetId="b0d1-ccab-8708-500f"/><infoLink id="0b62-edec-a8d3-c89a" name="Chosen Warriors" hidden="false" type="rule" targetId="13d1-9270-6539-08ed"/><infoLink id="ee13-5723-7cd1-c196" name="Stubborn" hidden="false" type="rule" targetId="7989-1f2c-a43d-82ae"/></infoLinks></selectionEntry><selectionEntry name="[LC] Castrmen Orth" type="unit" id="3a68-eb65-1c7b-cbdd" page="152" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="17f3-addd-12b0-0580" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="760f-8193-452f-e5c4" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="85"/></costs><selectionEntries><selectionEntry type="model" name="Castrmen Orth" id="931c-f4ca-88fa-1a9c" page="152" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="268a-cd2b-8901-b69a" name="Castrmen Orth" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">2</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">3</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">9</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">3+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Character, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="30bf-f1dc-3757-e91f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6543-914f-92a4-9c4d"/></constraints><entryLinks><entryLink id="f96f-dd35-1137-1c9e" name="Bolt Pistol" hidden="false" type="selectionEntry" targetId="e5ae-6872-37aa-8600"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2edb-d67c-985f-9273"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="38f8-b214-31e1-6bdc"/></constraints></entryLink><entryLink id="b058-054b-7e9a-8b6f" name="Power Maul" hidden="false" type="selectionEntry" targetId="0df4-c67e-cf64-82e0"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e445-6d1a-06d7-ce9e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9d5d-f8e9-92a8-572b"/></constraints></entryLink><entryLink id="2999-d9a9-cbe5-f651" name="Power Armour" hidden="false" type="selectionEntry" targetId="2d9d-480e-7c14-1a6f"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e718-2545-d4f6-2c8f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5612-f660-1a8d-de07"/></constraints></entryLink><entryLink id="5364-59eb-5285-8353" name="Cyber-Familiar" hidden="false" type="selectionEntry" targetId="6c85-4601-cf58-7b35"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8dfd-9abb-6da1-dfcf"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="976e-b7cc-aadd-1ff3"/></constraints></entryLink><entryLink id="8130-5523-90f8-eb2f" name="Refractor Field" hidden="false" type="selectionEntry" targetId="a06a-55a5-070b-1d0e"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="344a-cb1b-2b92-f57b"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1e6a-84e3-609f-72fd"/></constraints></entryLink><entryLink id="0026-f48c-c2ca-a88d" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="1476-a10c-6253-4c98"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8465-c4be-c14e-e0e7"/></constraints></entryLink><entryLink id="ab99-182c-ef69-3836" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ec49-40e0-87b2-45a3"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="578d-d790-c57e-32c7"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="9dcd-b010-387d-bc8b" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="fe2d-3bad-70ae-d3d0" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="7104-6dcd-438b-7f08" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="6819-d549-e3cf-c210" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="1b6f-9593-cff7-054e" name="Master-Crafted Power Maul" publicationId="3970-79bb-bdc6-9599" page="152" hidden="false"><description>Castrmen Orth's Power Maul has the Master-Crafted Special Rule.</description></rule><rule id="270a-0fae-6b51-2288" name="Spearhead Commander" publicationId="3970-79bb-bdc6-9599" page="152" hidden="false"><description>Before the game begins, assign Castrmen Orth to a Vehicle (not Knight, Titan or Unique) in the same Army with Front Armour of at least 13. He takes up no Transport Capacity and may not exit unless the vehicle is Immobilised or Destroyed. The vehicle may use his BS of 5 and add +1 Strength to a single Battle Weapon. It loses any variant of Legiones Astartes (X) and gains Legiones Astartes (Iron Hands). A unit he is assigned to may not purchase a Legiones Decurion upgrade. If a Primary Detachment containing Castrmen Orth selects the Rite of War: Armoured Spearhead, he must be your Warlord.</description></rule><rule id="0ec0-b042-795c-bcc8" name="Warlord: Blessing of the Gorgon" publicationId="3970-79bb-bdc6-9599" page="152" hidden="false"><description>If chosen as Warlord he has Blessing of the Gorgon and may not select another. While embarked via Spearhead Commander, that vehicle gains +1 to results on the Vehicle Damage table when making Shooting or Ramming attacks. The army may make an additional Reaction during the opponent's Shooting phase while he has not been removed as a casualty.</description></rule></rules><infoLinks><infoLink id="ba3d-f0c7-f02a-df33" name="Legiones Astartes (Iron Hands)" hidden="false" type="rule" targetId="2e45-4b61-44fb-260b"/><infoLink id="7f12-d5b5-d1e7-2708" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="afa7-08f9-d4eb-11d2" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/></infoLinks></selectionEntry><selectionEntry name="[LC] Iron-Father Kardozia" type="unit" id="1389-dab4-1ea6-71fc" page="153" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="0b01-64d0-0ad5-8309" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="5f38-04de-7aa5-0e1a" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="300"/></costs><selectionEntries><selectionEntry type="model" name="Kardozia" id="9646-78e5-fe5b-9479" page="153" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="7b3c-efec-4ffa-87c2" name="Kardozia" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">8</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">6</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">7</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">7</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">6</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">3</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Dreadnought (Character, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f399-7442-8f31-d5da"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7bbb-a69e-6e62-dabd"/></constraints><entryLinks><entryLink id="660e-866e-bfc1-024a" name="Gravis Power Fist" hidden="false" type="selectionEntry" targetId="08be-6994-6a63-6279"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f5fa-2890-9485-e511"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c7bc-84a7-3732-d42e"/></constraints></entryLink><entryLink id="a788-2d03-f0c4-e686" name="Gravis Chainfist" hidden="false" type="selectionEntry" targetId="5ffe-2820-9b97-99db"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="9dad-2cf5-1998-8f6b"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3d9c-faff-7cd2-43c2"/></constraints></entryLink><entryLink id="461a-22a4-88cc-1ff5" name="Machinator Array" hidden="false" type="selectionEntry" targetId="66f5-697c-605c-f1bb"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="af77-b43c-1571-0adc"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7281-010b-bfc0-3f5f"/></constraints></entryLink><entryLink id="fcf3-734e-770b-ead7" name="Atomantic Deflector" hidden="false" type="selectionEntry" targetId="38fb-9a0b-edef-a497"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c15a-6f93-53cb-f3d2"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f48c-97df-b8c9-493e"/></constraints></entryLink><entryLink id="2971-4a5e-8886-e965" name="Iron Halo" hidden="false" type="selectionEntry" targetId="b081-bf3c-f43d-4bd5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d023-f3b6-e758-c8dd"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cbba-26c6-1298-a4c0"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="fb2f-94f5-e6c7-b758" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="8949-8aff-ca54-fa0c" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="3a60-447a-312c-ee7d" name="dread" hidden="false" targetId="4280-4963-02b5-e31d" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="0b17-b2f8-ad8c-c110" name="In-built Graviton Shredders" publicationId="3970-79bb-bdc6-9599" page="153" hidden="false"><description>The Gravis Power Fist and Gravis Chainfist each have an in-built Graviton Shredder.</description></rule><rule id="058b-83e4-b429-36f0" name="Warlord: Gorgon Plating" publicationId="3970-79bb-bdc6-9599" page="153" hidden="false"><description>If chosen as Warlord he has Gorgon Plating and may not select another. Before the game begins select up to 3 vehicles in his detachment with Legiones Astartes (Iron Hands); they gain a 5+ Invulnerable save for the game (choose which to use if one already exists). The army may make an additional Reaction during the opponent's Movement phase while he has not been removed as a casualty.</description></rule></rules><infoLinks><infoLink id="7e54-0ac9-0a8d-9d6b" name="Legiones Astartes (Iron Hands)" hidden="false" type="rule" targetId="2e45-4b61-44fb-260b"/><infoLink id="71f9-eae9-08ca-fdbd" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="e6de-4a09-6276-4bc2" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/><infoLink id="15e2-c452-25d1-498c" name="Battlesmith (X)" hidden="false" type="rule" targetId="5d57-4d02-1e36-4a82"><modifiers><modifier type="set" field="name" value="Battlesmith (3+)"/></modifiers></infoLink><infoLink id="18ba-16b4-b3c8-6e7c" name="Hatred (X)" hidden="false" type="rule" targetId="dc0b-fe69-6b71-e0a4"><modifiers><modifier type="set" field="name" value="Hatred (Traitors)"/></modifiers></infoLink><infoLink id="817f-9fb9-4fee-5bbb" name="Feel No Pain (X)" hidden="false" type="rule" targetId="ec46-ff29-32e0-c2aa"><modifiers><modifier type="set" field="name" value="Feel No Pain (6+)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Lord Crius" type="unit" id="b431-7b6e-6b36-c820" page="154" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="2e2c-bc00-b29b-5098" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="4a22-05d2-7d40-f995" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="200"/></costs><selectionEntries><selectionEntry type="model" name="Lord Crius" id="ceba-b746-a927-3a50" page="154" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="d181-0faa-ca54-2451" name="Lord Crius" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">6*</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">6</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">5</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">5</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">4</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4*</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">3</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Ghola, Character, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="4d1b-0102-3bca-4399"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6286-b209-bcc8-c64d"/></constraints><entryLinks><entryLink id="0c35-e31d-e6a1-87b4" name="Vengeance of the Dead" hidden="false" type="selectionEntry" targetId="b833-27f8-13fe-39eb"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cc51-0db1-452c-d6ee"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7fe8-f7e7-7b3f-117c"/></constraints></entryLink><entryLink id="53e3-b30d-9e0e-52e7" name="Bolt Pistol" hidden="false" type="selectionEntry" targetId="e5ae-6872-37aa-8600"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f202-ccef-0eec-48be"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d244-824f-2d66-a566"/></constraints></entryLink><entryLink id="8827-ab61-1b8b-d556" name="Artificer Armour" hidden="false" type="selectionEntry" targetId="583e-62cb-53f1-f952"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="11c9-9ab6-5305-2fcd"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e617-b362-896f-0d4a"/></constraints></entryLink><entryLink id="8d6e-e5b2-5c3f-1695" name="Iron Halo" hidden="false" type="selectionEntry" targetId="b081-bf3c-f43d-4bd5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5635-a65b-25e8-e2ab"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f38c-a03c-bbcf-fe4c"/></constraints></entryLink><entryLink id="8ad8-28ec-5f7a-e342" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c9f7-8c0c-8f54-4798"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c526-45ac-ea04-23d5"/></constraints></entryLink><entryLink id="9228-63f2-e600-4375" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="612f-da8b-7fef-353d"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5638-9845-094e-d407"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="ac82-b80e-77b5-6900" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="af08-e5eb-31c1-f76f" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="6a7c-4475-0547-4f89" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="0232-8f8e-e96a-f0ef" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="33fd-7ebe-7adf-b72b" name="Ghola Sub-type" publicationId="3970-79bb-bdc6-9599" page="154" hidden="false"><description>-1 penalty to Movement and Initiative (already applied in the profile). Gains the Heavy Unit Sub-type, Feel No Pain (5+) and Stubborn. Successful Wounds from attacks with Poisoned or Fleshbane must be re-rolled against models with the Ghola Sub-type.</description></rule><rule id="295e-8d98-10cf-5b6f" name="The Keys of Hel" publicationId="3970-79bb-bdc6-9599" page="154" hidden="false"><description>Lord Crius has the Keys of Hel Special Rule (see the Keys of Hel upgrade, p.150).</description></rule><rule id="3e45-b940-2f05-7528" name="Warlord: The Revenant's Revenge" publicationId="3970-79bb-bdc6-9599" page="154" hidden="false"><description>If chosen as Warlord he has The Revenant's Revenge and may not select another. He may select up to 3 Ghola units in his detachment; they gain Rage (2) but lose the Line Sub-type, and may not be joined by any Independent Characters except Lord Crius or an Iron-Father with the Keys of Hel. The army may make an additional Reaction during the opponent's Assault phase while he has not been removed as a casualty.</description></rule><rule id="0090-7a95-a27b-1b0c" name="Characteristics" publicationId="3970-79bb-bdc6-9599" page="154" hidden="false"><description>*The Characteristic penalties inflicted by the Ghola Sub-type are already applied.</description></rule></rules><infoLinks><infoLink id="ca7b-0646-642a-e1f2" name="Legiones Astartes (Iron Hands)" hidden="false" type="rule" targetId="2e45-4b61-44fb-260b"/><infoLink id="7c7b-ee7f-d541-6c65" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="ee19-3f7a-50be-16b9" name="Hatred (X)" hidden="false" type="rule" targetId="dc0b-fe69-6b71-e0a4"><modifiers><modifier type="set" field="name" value="Hatred (Traitors)"/></modifiers></infoLink><infoLink id="93ca-aa8b-1526-41a2" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="3a64-50bc-a462-370b" name="Bulky (X)" hidden="false" type="rule" targetId="676c-7b75-4b6f-9405"><modifiers><modifier type="set" field="name" value="Bulky (2)"/></modifiers></infoLink><infoLink id="b273-9bd4-d520-e557" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/><infoLink id="0945-35dc-651b-020c" name="Hammer of Wrath (X)" hidden="false" type="rule" targetId="aec0-c3aa-1e4e-1779"><modifiers><modifier type="set" field="name" value="Hammer of Wrath (1)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Gabriel Santar" type="unit" id="3d17-9603-9e1f-ad8c" page="155" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="96ae-a2d5-d3ee-6e75" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="af44-39be-1ccc-99d2" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="220"/></costs><selectionEntries><selectionEntry type="model" name="Gabriel Santar" id="c5fe-fdac-7f5f-fe22" page="155" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="2e32-f4c2-5d99-6469" name="Gabriel Santar" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">6</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">6</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">4</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">5</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">6*</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Character, Heavy, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="3639-f420-2c6c-31d9"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e400-77cf-8f75-a743"/></constraints><entryLinks><entryLink id="2e23-659f-f298-3425" name="Claws of the Iron Forge" hidden="false" type="selectionEntry" targetId="7255-b7dc-e240-2da1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0ecc-f170-74f3-3c6e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bd7a-7702-e73b-c3e3"/></constraints></entryLink><entryLink id="6eaf-f8b6-fffb-c993" name="Cataphractii Terminator Armour" hidden="false" type="selectionEntry" targetId="7c9b-b9ab-9a40-8eb5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5c62-031d-0eb1-8ba3"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df9b-57ab-7157-87fc"/></constraints></entryLink><entryLink id="8c86-bf32-1391-01d2" name="Cyber-Familiar" hidden="false" type="selectionEntry" targetId="6c85-4601-cf58-7b35"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="466f-81e5-2833-d4e9"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b84f-7bd5-8998-201a"/></constraints></entryLink><entryLink id="6ad2-fe08-0216-1c54" name="Grenade Harness" hidden="false" type="selectionEntry" targetId="251a-860d-2c4d-62cc"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="fd6b-3125-8397-b6f1"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cc55-4f8c-fd2b-834b"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="370f-878f-44e6-e500" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="6fb8-3d37-22fe-7089" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="912b-a69f-a4b2-4c15" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="95c1-0bba-75f3-7157" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="47b5-cb2a-a836-7881" name="heavy" hidden="false" targetId="9231-183c-b97b-63f9" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="a9cf-7b17-2bd4-9844" name="Warlord: Fist of the Gorgon" publicationId="3970-79bb-bdc6-9599" page="155" hidden="false"><description>If chosen as Warlord he has Fist of the Gorgon and may not select another. He and any Iron Hands models in a unit he has joined gain Furious Charge (1) and may ignore the first Wound inflicted on that unit in each Phase (no Saves or Damage Mitigation rolls; no other rules triggered). The army may make an additional Reaction during the opponent's Assault phase while he has not been removed as a casualty.</description></rule><rule id="fd59-365c-1ce9-ffd6" name="Claws of the Iron Forge" publicationId="3970-79bb-bdc6-9599" page="155" hidden="false"><description>Treated as Power Weapons for all rules that affect such weapons, and grant two bonus attacks in the manner of Lightning Claws (included in his profile).</description></rule></rules><infoLinks><infoLink id="c642-a7f4-b3f6-44f6" name="Legiones Astartes (Iron Hands)" hidden="false" type="rule" targetId="2e45-4b61-44fb-260b"/><infoLink id="50a5-10d8-d0ae-7368" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="c214-8b4d-ab04-06c5" name="Stubborn" hidden="false" type="rule" targetId="7989-1f2c-a43d-82ae"/><infoLink id="a0c3-b94e-583c-0826" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="2ebd-4e62-43ab-cc42" name="Battle-Hardened (X)" hidden="false" type="rule" targetId="5c3b-ed0b-4ad0-d547"><modifiers><modifier type="set" field="name" value="Battle-Hardened (1)"/></modifiers></infoLink><infoLink id="ebb4-ef3d-22f0-9798" name="Bulky (X)" hidden="false" type="rule" targetId="676c-7b75-4b6f-9405"><modifiers><modifier type="set" field="name" value="Bulky (2)"/></modifiers></infoLink><infoLink id="47b1-e219-6406-539e" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/></infoLinks></selectionEntry><selectionEntry name="[LC] Helfather Covenant" type="unit" id="ed95-9f48-8e24-c1cc" page="156" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="a967-fc5e-77d5-212f" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="ac55-32ac-858c-2049" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="270"/></costs><selectionEntries><selectionEntry type="model" name="Helfather" id="3ee6-0b16-2d68-2715" page="156" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="f134-27d9-c9c1-b26f" name="Helfather" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">5*</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">4</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">4</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">5</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">3</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">2*</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">2</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">9</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Ghola)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="5f50-97b7-6c66-2674"/><constraint type="max" value="3" field="selections" scope="parent" shared="true" id="1848-02a6-ee76-8dd0"/></constraints><entryLinks><entryLink id="5173-904f-eb55-542b" name="Gorgon Terminator Armour" hidden="false" type="selectionEntry" targetId="e7f0-0c5c-612b-7982"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f115-071a-9781-8382"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="59e0-0444-2611-090e"/></constraints></entryLink><entryLink id="cbd0-8061-db68-0336" name="Power Fist" hidden="false" type="selectionEntry" targetId="768d-b89b-7328-d749"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="082a-c25a-4f70-e043"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f9ee-907b-1f65-7787"/></constraints></entryLink><entryLink id="3675-11d6-3fff-43bf" name="Proteus Assault Cannon" hidden="false" type="selectionEntry" targetId="da1a-85ed-813f-829a"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0691-961f-ef72-b803"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bbfd-e494-3842-76ba"/></constraints></entryLink><entryLink id="c7da-620f-09fb-ffca" name="Missile Launcher" hidden="false" type="selectionEntry" targetId="0ec3-6c91-952c-e0ea"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="fc24-3965-951c-acd6"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ad6d-ad25-83cb-e3e5"/></constraints></entryLink></entryLinks><selectionEntryGroups><selectionEntryGroup id="348f-614c-28ab-afdc" name="Augury Scanner" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3" field="selections" scope="parent" shared="true" id="8989-669f-aee8-30c8"/></constraints><entryLinks><entryLink id="d19d-f264-4047-ae5b" name="Augury Scanner" hidden="false" type="selectionEntry" targetId="67ee-7338-3b74-04b4"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="84bb-0fe1-5d02-686f" name="Nuncio-Vox" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="3" field="selections" scope="parent" shared="true" id="3bd3-b640-e27f-667a"/></constraints><entryLinks><entryLink id="22f1-cbe4-c5fb-bf7f" name="Nuncio Vox" hidden="false" type="selectionEntry" targetId="005e-aae6-ddac-bb45"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="3f48-da30-9a88-0c0a" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="d678-a273-9ee8-06a0" name="Ghola Sub-type" publicationId="3970-79bb-bdc6-9599" page="156" hidden="false"><description>-1 penalty to Movement and Initiative (already applied in the profile). Gains the Heavy Unit Sub-type, Feel No Pain (5+) and Stubborn. Successful Wounds from attacks with Poisoned or Fleshbane must be re-rolled against models with the Ghola Sub-type.</description></rule><rule id="721c-6db8-f15c-4b11" name="Agesine Protocols" publicationId="3970-79bb-bdc6-9599" page="156" hidden="false"><description>A model with this Special Rule may never make a Sweeping Advance.</description></rule><rule id="8178-9f87-ece6-ab3e" name="Helfather Retinue" publicationId="3970-79bb-bdc6-9599" page="156" hidden="false"><description>A Helfather Covenant may only be included in a Detachment if selected as a Retinue Squad, in a Detachment that includes at least one model with Master of the Legion, Legiones Astartes (Iron Hands) and the Keys of Hel. That model must be the squad's leader and may not voluntarily leave. Uses no Force Organisation slot and is part of the same unit as its leader. 0-1.</description></rule><rule id="687f-cd9b-3818-3b9c" name="Wargear" publicationId="3970-79bb-bdc6-9599" page="156" hidden="false"><description>Missile Launcher with Frag and Krak Missiles. Proteus Assault Cannon: see page 18 of the Legacies of the Age of Darkness Document. *Ghola characteristic penalties already applied.</description></rule></rules><infoLinks><infoLink id="64f2-95fd-cca2-29ed" name="Legiones Astartes (Iron Hands)" hidden="false" type="rule" targetId="2e45-4b61-44fb-260b"/><infoLink id="4515-d2ed-1e6a-99f8" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="4f6c-884a-53b3-923e" name="It Will Not Die (X)" hidden="false" type="rule" targetId="2784-d0be-a4e2-890f"><modifiers><modifier type="set" field="name" value="It Will Not Die (5+)"/></modifiers></infoLink><infoLink id="2364-2d6a-8ea4-33da" name="Firing Protocols (X)" hidden="false" type="rule" targetId="32a3-f599-5c92-2945"><modifiers><modifier type="set" field="name" value="Firing Protocols (2)"/></modifiers></infoLink><infoLink id="32c7-5e27-ecb9-50a8" name="Hammer of Wrath (X)" hidden="false" type="rule" targetId="aec0-c3aa-1e4e-1779"><modifiers><modifier type="set" field="name" value="Hammer of Wrath (1)"/></modifiers></infoLink><infoLink id="008b-2d02-26c2-fb3a" name="Bulky (X)" hidden="false" type="rule" targetId="676c-7b75-4b6f-9405"><modifiers><modifier type="set" field="name" value="Bulky (3)"/></modifiers></infoLink><infoLink id="7e32-6f66-e2a1-a717" name="Chosen Warriors" hidden="false" type="rule" targetId="13d1-9270-6539-08ed"/></infoLinks></selectionEntry><selectionEntry name="[LC] Iron Revenants" type="unit" id="21c3-8827-c722-18d7" page="157" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="a0c3-8cdd-4c0a-c1ed" name="elites" hidden="false" targetId="7aee-565f-b0ae-294e" primary="true"/><categoryLink id="5fde-91e4-ac1b-4fea" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="58"/></costs><selectionEntries><selectionEntry type="model" name="Iron Revenant" id="e855-fb1b-d1a2-c09c" page="157" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="c38a-3043-1a60-6fea" name="Iron Revenant" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">6*</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">4</characteristic><characteristic typeId="7