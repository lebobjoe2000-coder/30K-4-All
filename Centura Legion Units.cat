"><description>If chosen as Warlord he has Vital Strike and may not select another. When rolling to wound with any weapon with Rending, Breaching or Murderous Strike, Nykona and any unit entirely of Legiones Astartes (Raven Guard) models he has joined treat those rules as one point lower (e.g. Breaching (4+) counts as Breaching (3+)). The army may make an additional Reaction during the opponent's Assault phase while he has not been removed as a casualty.</description></rule></rules><infoLinks><infoLink id="28d8-16b7-cd20-6416" name="Legiones Astartes (Raven Guard)" hidden="false" type="rule" targetId="9924-9434-baa1-0894"/><infoLink id="b2e2-6301-a9ea-e893" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="961e-ba06-f640-d96c" name="Shrouded (X)" hidden="false" type="rule" targetId="10c3-fdb0-089f-ca65"><modifiers><modifier type="set" field="name" value="Shrouded (4+)"/></modifiers></infoLink><infoLink id="cc77-d965-571e-7fd8" name="Hit &amp; Run" hidden="false" type="rule" targetId="5986-e960-d432-affd"><modifiers><modifier type="set" field="name" value="Hit and Run"/></modifiers></infoLink><infoLink id="683a-f2ba-d7c1-49e8" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/></infoLinks></selectionEntry><selectionEntry name="[LC] Navar Hef" type="unit" id="e651-bb3e-bacd-2f0b" page="205" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="80ca-c133-0a6c-b788" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="ef2e-9375-a7b4-578f" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="160"/></costs><selectionEntries><selectionEntry type="model" name="Navar Hef" id="0ff6-0dde-60f7-cf8a" page="205" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="0e40-a1d6-819b-0851" name="Navar Hef" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic 