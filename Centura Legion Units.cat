f6-67f8-19b5"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="2"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="e201-d51b-a78b-78d6" name="Exchange Bolter for" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="97e5-cb07-b31c-8bc6"/></constraints><entryLinks><entryLink id="5722-e858-4abb-7e91" name="Flamer" hidden="false" type="selectionEntry" targetId="9f41-82e2-90f6-973a"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="385e-dd7a-366b-b7fc" name="Exchange Chainsword for" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="e90f-5552-7775-5514"/></constraints><entryLinks><entryLink id="7d80-1d73-aa30-f9fc" name="Chainaxe" hidden="false" type="selectionEntry" targetId="85b9-4e50-af11-c295"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="2"/></costs></entryLink><entryLink id="4e0b-abbd-8c1a-762e" name="Power Weapon" hidden="false" type="selectionEntry" targetId="d2db-7598-f55f-86fe"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink><entryLink id="8223-264e-4962-f33e" name="Lightning Claw" hidden="false" type="selectionEntry" targetId="6923-4e42-5691-b13f"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="7448-6573-b2f5-9196" name="Exchange Chainsword and Bolter for" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="66e0-dcd0-90ac-df96"/></constraints><entryLinks><entryLink id="0d2e-645d-7ee4-4a26" name="Two Lightning Claws" hidden="false" type="selectionEntry" targetId="a6d2-b3a9-6d2c-1f6f"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="8865-dbba-9b9a-f4e7" name="Exchange Chainsword for (1 per 5 models)" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="ae69-4f9a-32fc-2950"/></constraints><entryLinks><entryLink id="0d42-2f2b-31c9-f912" name="Power Fist" hidden="false" type="selectionEntry" targetId="768d-b89b-7328-d749"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="15"/></costs></entryLink><entryLink id="80e7-e4ea-a1c3-08b2" name="Thunder Hammer" hidden="false" type="selectionEntry" targetId="838c-4002-713d-d7c6"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="227b-8d17-87d6-e952" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/></categoryLinks></selectionEntry></selectionEntries><entryLinks><entryLink id="4b1c-7f74-ea39-06d2" name="Surgical Augment (Unit)" hidden="false" collective="false" import="true" targetId="bcb4-86cb-166b-f0e1" type="selectionEntryGroup"/></entryLinks><rules><rule id="ab34-35e7-d3fd-2124" name="The Mongrel Legion" publicationId="3970-79bb-bdc6-9599" page="108" hidden="false"><description>This unit is considered to have the Legiones Astartes (Emperor's Children) Special Rule for all rules that interact with it, such as army selection, but cannot claim the bonuses provided by it. In addition, this unit may not be joined by any Independent Character except Fabius Bile. 0-1 per army (unless Fabius Bile is present).</description></rule><rule id="9a07-8b37-9fd7-cc72" name="Unstable Disposition" publicationId="3970-79bb-bdc6-9599" page="108" hidden="false"><description>A unit with this special rule automatically passes the first failed Morale or Pinning test they are called upon to make each turn.</description></rule><rule id="5072-88c9-3208-b724" name="Genetic Enhancement" publicationId="3970-79bb-bdc6-9599" page="108" hidden="false"><description>During Army Selection each unit with this rule must choose one: Quicksilver Speed (+1 Movement and Initiative); Hardened Carapace (+1 Toughness and a 3+ Armour Save); Stimulant Overdrive (+1 Strength and Feel No Pain (4+)).</description></rule></rules><infoLinks><infoLink id="8fe2-439f-5613-9659" name="Stubborn" hidden="false" type="rule" targetId="7989-1f2c-a43d-82ae"/><infoLink id="d54b-5bd5-a6ce-3e6d" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="b6a8-d338-f333-d625" name="Feel No Pain (X)" hidden="false" type="rule" targetId="ec46-ff29-32e0-c2aa"><modifiers><modifier type="set" field="name" value="Feel No Pain (5+)"/></modifiers></infoLink><infoLink id="f5f2-83a3-39d5-6ac1" name="Traitor" hidden="false" type="rule" targetId="eff2-8b0e-21da-2f0d"/></infoLinks></selectionEntry><selectionEntry name="[LC] Barabas Dantioch" type="unit" id="fd1b-fcd8-cea7-73af" page="113" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="066a-5ff1-5380-c16f" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="5082-1377-cbb6-3b2c" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="175"/></costs><selectionEntries><selectionEntry type="model" name="Barabas Dantioch" id="59bb-9bee-5044-f5ae" page="113" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="fa29-6805-9073-6c9e" name="Barabas Dantioch" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">6</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">3</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">3</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Character, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="176b-346c-dd66-ae27"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ebde-3696-5f51-9717"/></constraints><entryLinks><entryLink id="ef50-c841-7390-1f32" name="Plasma Pistol" hidden="false" type="selectionEntry" targetId="717f-cf0a-1593-4bd8"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c852-29be-d21a-8cb1"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fdcf-f2b8-a9ab-7c68"/></constraints></entryLink><entryLink id="1c3c-4d42-49ab-5eba" name="Thunder Hammer" hidden="false" type="selectionEntry" targetId="838c-4002-713d-d7c6"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b493-9d09-5b43-bc40"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f9a7-ac5d-ab48-1226"/></constraints></entryLink><entryLink id="b4e7-b40c-25cf-e42d" name="Artificer Armour" hidden="false" type="selectionEntry" targetId="583e-62cb-53f1-f952"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e642-c6b8-9778-0aa0"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e4cd-1563-e52c-5975"/></constraints></entryLink><entryLink id="4573-dc97-3564-9da0" name="Iron Halo" hidden="false" type="selectionEntry" targetId="b081-bf3c-f43d-4bd5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c36b-fb12-e0be-5056"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="40e3-f811-411d-05ca"/></constraints></entryLink><entryLink id="cbfe-5482-da58-cfd9" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="fbc9-44bd-531e-508a"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2ab7-4c29-91ab-83a6"/></constraints></entryLink><entryLink id="b2f2-408d-71d8-9a17" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="279e-7df4-bed6-0bf8"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="33e0-58f5-64c4-f88e"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="5439-2e60-3b9c-a1aa" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="b115-9f4d-d5ac-b4e0" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="7011-380a-399b-22d6" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="09d1-a16d-8233-c99e" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="edd5-3b9a-1e3c-4b7d" name="The Death Mask" publicationId="3970-79bb-bdc6-9599" page="113" hidden="false"><description>Barabas Dantioch has the Fear (2) Special Rule, but this only applies to enemy units which contain Legiones Astartes (Iron Warriors).</description></rule><rule id="76ed-2088-7df9-7c6d" name="Master-Crafted Thunder Hammer" publicationId="3970-79bb-bdc6-9599" page="113" hidden="false"><description>Barabas Dantioch's Thunder Hammer has the Master-Crafted Special Rule.</description></rule><rule id="fa6d-e247-8125-bfa1" name="Lord of the Schadenhold" publicationId="3970-79bb-bdc6-9599" page="113" hidden="false"><description>Before the game begins, nominate up to two Fortifications or Terrain features in your deployment zone. The cover saves offered by these are increased by 1.</description></rule><rule id="12f0-6c52-8193-0f80" name="Tetrach's Chosen" publicationId="3970-79bb-bdc6-9599" page="113" hidden="false"><description>Barabas Dantioch may be included in an Iron Warriors detachment, or a detachment that has either the Legiones Astartes (Ultramarines) or (Imperial Fists) Special Rules. He retains his Legiones Astartes (Iron Warriors) rule, but may not be your Warlord in such a detachment. All units in such a detachment treat Barabas Dantioch as Sworn Brothers - however Barabas Dantioch may not embark in Transports from the detachment.</description></rule><rule id="df0c-0b94-0350-4150" name="Warlord: The Iron Litany" publicationId="3970-79bb-bdc6-9599" page="113" hidden="false"><description>If chosen as the army's Warlord, Barabas Dantioch automatically has The Iron Litany as his Warlord Trait and may not select any other. He and any unit he joins gain the Fearless and Counter-Attack Special Rules.</description></rule><rule id="2f50-bcf7-580b-fa4e" name="Warsmith and Siege Breaker" publicationId="3970-79bb-bdc6-9599" page="113" hidden="false"><description>For the purposes of Rites of War and mandatory unit selections only, Barabas Dantioch counts as a Warsmith and a Siege Breaker.</description></rule></rules><infoLinks><infoLink id="ea60-a863-0463-9064" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><infoLink id="9abe-51fc-bc8e-d129" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="2167-6b52-88f2-42ee" name="Master of Automata" hidden="false" type="rule" targetId="8eef-f84b-37cb-554b"/><infoLink id="40d7-0d05-c9b7-90cd" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/><infoLink id="0fc7-634f-81d9-6cdc" name="Hatred (X)" hidden="false" type="rule" targetId="dc0b-fe69-6b71-e0a4"><modifiers><modifier type="set" field="name" value="Hatred (Traitors)"/></modifiers></infoLink><infoLink id="99e5-5026-d0e7-5a9e" name="Battlesmith (X)" hidden="false" type="rule" targetId="5d57-4d02-1e36-4a82"><modifiers><modifier type="set" field="name" value="Battlesmith (3+)"/></modifiers></infoLink><infoLink id="0258-5e1c-bbe9-f99b" name="Feel No Pain (X)" hidden="false" type="rule" targetId="ec46-ff29-32e0-c2aa"><modifiers><modifier type="set" field="name" value="Feel No Pain (5+)"/></modifiers></infoLink><infoLink id="49bc-e216-a9c5-1c8f" name="Fearless" hidden="false" type="rule" targetId="b48c-d7e1-2a83-2f5b"/><infoLink id="4782-3c26-99d3-2555" name="Counter-Attack (X)" hidden="false" type="rule" targetId="fd6d-2a76-10e0-936a"><modifiers><modifier type="set" field="name" value="Counter-Attack (1)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Volk-Sa'ra'ram" type="unit" id="726c-cbf4-0a1f-d1ad" page="114" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="e4ee-4ffc-bef1-d9fe" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="fe91-74fc-e505-2bad" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="300"/></costs><selectionEntries><selectionEntry type="model" name="Volk-Sa'ra'ram" id="95c0-19b6-eb73-7768" page="114" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="9298-2a4c-ec02-3465" name="Volk-Sa'ra'ram" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">6</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">5</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">6</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">5</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">3</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">9</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Heavy, Corrupted, Monstrous, Character, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e8bd-da7c-35be-7b6c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3c8f-af39-f892-f24f"/></constraints><entryLinks><entryLink id="b22e-c6aa-a282-499d" name="Fleshmetal Plating" hidden="false" type="selectionEntry" targetId="fc77-b3b4-c0cb-d86f"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="287f-100b-93f5-e05f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ecd6-3c06-e36a-f022"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="baf1-b2e7-5d13-32a5" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="2661-a911-c9ce-8fb9" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="d4e6-b4ea-2c7e-8ac3" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="3314-9684-d58c-d764" name="heavy" hidden="false" targetId="9231-183c-b97b-63f9" primary="false"/><categoryLink id="0ff6-b80a-3d14-3b2c" name="corrupted" hidden="false" targetId="9055-7410-8ffd-b8e7" primary="false"/><categoryLink id="1a0a-4969-715c-92ac" name="monstrous" hidden="false" targetId="7d95-f9d1-440a-67bd" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="863d-b513-9d4f-eccc" name="Fleshmetal Plating" publicationId="3970-79bb-bdc6-9599" page="114" hidden="false"><description>Confers a 2+ Armour Save and a 4+ Invulnerable Save. If a model with this wargear suffers an unsaved Wound with the Instant Death Special Rule, it is not removed but loses 2 wounds for each such Wound inflicted.</description></rule><rule id="3edc-88bc-25fd-2375" name="Morphogenic Weaponry" publicationId="3970-79bb-bdc6-9599" page="114" hidden="false"><description>At the start of each of the Controlling Player's turns select two different ranged options and a single melee option; Volk-Sa'ra'ram counts as armed with them until the start of your next turn. May not make the same selections two turns in a row. Ranged: Shrapnel Cannon, Heavy Flamer, Volkite Culverin, Autocannon, Plasma Cannon, Multi-Melta, Lascannon. Melee: Chainfist, Graviton Maul, Two Lightning Claws, Power Lance.</description></rule><rule id="ef51-81bf-36c0-b28e" name="Warlord: Obliteration Protocols" publicationId="3970-79bb-bdc6-9599" page="114" hidden="false"><description>If chosen as Warlord he has Obliteration Protocols and may not select another. When he targets an enemy unit with a Shooting attack that has already been targeted in the same phase by a friendly unit entirely of Legiones Astartes (Iron Warriors), he may fire any Heavy Weapon twice; the additional shots gain Gets Hot (or Gets Hot on a 1 or 2 if already present). The army gains an additional reaction in the Opposing Player's Shooting phase while he has not been removed as a casualty.</description></rule></rules><infoLinks><infoLink id="374b-2381-870d-37ff" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><i