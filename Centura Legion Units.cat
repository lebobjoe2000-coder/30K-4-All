72-9df2-857e-8521"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0a13-5b79-fee3-6753"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="62ef-cd37-169b-c251"/></constraints></entryLink><entryLink id="f5d7-50e6-3822-42f7" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="3599-eee2-64dc-ff37"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1c61-b06b-435d-0ca9"/></constraints></entryLink><entryLink id="3467-b5fe-b4b9-5746" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6e1c-7fe9-17f2-4dba"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1662-5966-f5eb-c075"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="b6ba-1f9b-ec9d-28d7" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="6138-89dc-e8de-10cb" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="afc9-5b39-043b-f508" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="a78f-68e0-0207-5955" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="7465-829a-8fda-07b6" name="Herald of the Primarch" publicationId="3970-79bb-bdc6-9599" page="146" hidden="false"><description>A model with this Special Rule must always issue or accept challenges whenever possible. When fighting in a challenge Azkaellon increases his Weapon Skill by 1 and his melee attacks gain Brutal (2).</description></rule><rule id="d27a-ae4f-9dcb-54ea" name="Warlord: Encarmine Paladin" publicationId="3970-79bb-bdc6-9599" page="146" hidden="false"><description>If chosen as Warlord he has Encarmine Paladin and may not select another (see Liber Astartes page 250).</description></rule><rule id="4488-7ad5-6dbc-59f6" name="Artisans of War" publicationId="3970-79bb-bdc6-9599" page="146" hidden="false"><description>When a model with this Special Rule fights in the Assault phase, it may re-roll all To Hit rolls of 1.</description></rule></rules><infoLinks><infoLink id="2a86-0e9f-0bf1-9819" name="Legiones Astartes (Blood Angels)" hidden="false" type="rule" targetId="b0d1-ccab-8708-500f"/><infoLink id="ba84-6b1e-6304-82b5" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="ef51-c27c-c4c4-3a48" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="2f0f-c78a-3d8e-1487" name="Fearless" hidden="false" type="rule" targetId="b48c-d7e1-2a83-2f5b"/><infoLink id="c6bb-95c4-5e91-bc9a" name="Furious Charge (X)" hidden="false" type="rule" targetId="2821-9269-862f-0554"><modifiers><modifier type="set" field="name" value="Furious Charge (1)"/></modifiers></infoLink><infoLink id="164e-3933-6743-de09" name="Loyalist" hidden="false" type="rule" targetId="d1de-a45d-2b9b-c878"/></infoLinks></selectionEntry><selectionEntry name="[LC] Sanguinary Guard" type="unit" id="b90a-6a34-2960-7b42" page="147" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="55d1-7b17-0d6a-f84c" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="5bd2-efcf-5df0-37bf" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/></costs><selectionEntries><selectionEntry type="model" name="Sanguinary Guard" id="60fe-c0dd-e986-980b" page="147" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="7c30-e948-f119-07b5" name="Sanguinary Guard" typeId="4bb2-cb95-e6c8-5a2