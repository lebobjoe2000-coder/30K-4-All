ryLink><entryLink id="0248-57a0-b3d0-c454" name="Power Fist" hidden="false" type="selectionEntry" targetId="768d-b89b-7328-d749"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="9726-ac8e-7474-70bd" name="Exchange Power Armour for" hidden="false" collective="false" import="true" defaultSelectionEntryId="d737-0e85-524a-e29c"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="a707-36a5-0fc3-232c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="51f9-addc-1df3-5989"/></constraints><entryLinks><entryLink id="d737-0e85-524a-e29c" name="Power Armour" hidden="false" type="selectionEntry" targetId="2d9d-480e-7c14-1a6f"/><entryLink id="978d-1954-83b7-5938" name="Artificer Armour" hidden="false" type="selectionEntry" targetId="583e-62cb-53f1-f952"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="330a-b975-d39c-c899" name="May take" hidden="false" collective="false" import="true"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="231e-a890-ee98-5f5c"/></constraints><entryLinks><entryLink id="1067-8e88-1434-33c2" name="Melta Bombs" hidden="false" type="selectionEntry" targetId="e55d-d31b-46a9-aeb6"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="bd2f-601c-ab40-8eeb" name="cavalry" hidden="false" targetId="6d79-a3e4-381f-7b0f" primary="false"/><categoryLink id="25c1-011d-d07f-451c" name="antigrav" hidden="false" targetId="4303-1348-cce4-9501" primary="false"/><categoryLink id="826a-66f6-207e-4485" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="5bad-d85b-520f-b9ed" name="Winds of the Storm" publicationId="3970-79bb-bdc6-9599" page="128" hidden="false"><description>A unit that includes any models with this Special Rule may only be joined by a Legion Centurion with the Legiones Consularis: Stormseer upgrade, or by Targutai Yesugei. Legion Techmarines and Apothecaries may not join unless they also have this rule.</description></rule><rule id="1304-a0c6-4a77-fe1a" name="Stormseer's Conclave" publicationId="3970-79bb-bdc6-9599" page="128" hidden="false"><description>A Wind Rider Squadron in a Detachment with a Stormseer Consul (or Targutai Yesugei) may be selected as a Retinue Squad instead of as a Fast Attack choice, led by that character; it uses no Force Organisation slot and is part of the same unit as its Leader.</description></rule><rule id="bdb9-6b0a-de98-18f3" name="Hit and Run" publicationId="3970-79bb-bdc6-9599" page="128" hidden="false"><description>Special rule as printed in the Liber Centura.</description></rule><rule id="4f1e-2d9f-48f9-efae" name="Movement" publicationId="3970-79bb-bdc6-9599" page="128" hidden="false"><description>*The additional Movement bonus granted by the Legiones Astartes (White Scars) Special Rule is included. The in-built Volkite Culverin replaces the Heavy Bolter normally in-built to a Legion Scimitar Jetbike.</description></rule></rules><infoLinks><infoLink id="c1da-19d2-3d00-8d79" name="Legiones Astartes (White Scars)" hidden="false" type="rule" targetId="4b54-8bd0-9fdd-cbc4"/><infoLink id="fe04-2356-0fdc-f1a4" name="Stubborn" hidden="false" type="rule" targetId="7989-1f2c-a43d-82ae"/><infoLink id="e0b2-8653-1653-2a98" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="6ce6-358e-468d-2515" name="Firing Protocols (X)" hidden="false" type="rule" targetId="32a3-f599-5c92-2945"><modifiers><modifier type="set" field="name" value="Firing Protocols (2)"/></modifiers></infoLink><infoLink id="fdcc-67b2-67b7-0ab0" name="Hammer of Wrath (X)" hidden="false" type="rule" targetId="aec0-c3aa-1e4e-1779"><modifiers><modifier type="set" field="name" value="Hammer of Wrath (1)"/></modifiers></infoLink><infoLink id="3fbf-2f79-57e5-f603" name="Deep Strike" hidden="false" type="rule" targetId="f1e1-986f-c783-ca9e"/></infoLinks></selectionEntry><selectionEntry name="[LC] Varagyr Wolf Guard Tartaros Terminator Squad" type="unit" id="8a98-7ed4-571b-7aeb" page="133" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="9232-e67a-c26b-f37e" name="elites" hidden="false" targetId="7aee-565f-b0ae-294e" primary="true"/><categoryLink id="c89a-53ad-30f8-ca55" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/><categoryLink id="0551-65e6-0639-eb9e" name="terminators" hidden="false" targetId="bab3-f50d-3e5f-2f78" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="65"/></costs><selectionEntries><selectionEntry type="model" name="Varagyr Tartaros" id="1da3-01a0-788d-0931" page="133" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="079c-3d5d-afad-6cab" name="Varagyr Tartaros" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">4</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">2</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">2</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">8</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry</characteristic></character