-4bd5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="05b9-58a9-16ee-f5c8"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6472-da09-91b0-dbc4"/></constraints></entryLink><entryLink id="1820-fde2-2001-74eb" name="Trophies of Judgement" hidden="false" type="selectionEntry" targetId="bde7-7c77-5973-cd52"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c551-0aa4-510e-ed12"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="04f6-f504-4d9c-f80a"/></constraints></entryLink><entryLink id="e085-676f-eef5-4118" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="09a1-4c60-f93f-eabd"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="893a-7d8e-3a86-708e"/></constraints></entryLink><entryLink id="e4e1-ab97-aec3-b325" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5323-e63c-1fe6-fa96"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bf81-c7dd-f122-1afe"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="50a1-50f5-8e23-66b0" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="c8d0-5f36-137c-fb2f" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="1876-6013-68f4-6ae1" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="2878-3670-e207-c4df" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="8361-4953-0e52-950f" name="Spiteful Binding" publicationId="3970-79bb-bdc6-9599" page="140" hidden="false"><description>At the end of any Player's Assault phase, if Skraivok has attacked in Melee against an enemy model with a higher WS than his own, his controlling player must roll a D6. On a 6, Skraivok is immediately removed from play as a casualty. If he is removed in this way, the opposing player may not claim VP towards Slay the Warlord.</description></rule><rule id="e063-21ab-b7fc-9e93" name="Dirty Fighter" publicationId="3970-79bb-bdc6-9599" page="140" hidden="false"><description>When engaged in a Challenge with a model whose Weapon Skill is 5 or more, Skraivok gains the Instant Death special rule on all attacks made during that Challenge. (Wording taken from Sevatar's entry, as referenced by the Liber Centura.)</description></rule></rules><infoLinks><infoLink id="b637-1a3a-e3c5-df74" name="Legiones Astartes (Night Lords)" hidden="false" type="rule" targetId="8280-d4ea-b131-4970"/><infoLink id="d411-2aa8-c63c-d29f" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="4b5a-b0c9-f586-9815" name="Traitor" hidden="false" type="rule" targetId="eff2-8b0e-21da-2f0d"/></infoLinks></selectionEntry><selectionEntry name="[LC] Contekar Cataphractii Terminator Squad" type="unit" id="fb17-0b5f-57de-793a" page="141" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="b8d5-d29e-a286-f5d7" name="elites" hidden="false" targetId="7aee-565f-b0ae-294e" primary="true"/><categoryLink id="38c2-fc29-6c71-0a21" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/><categoryLink id="9e60-f108-33a2-df2f" name="terminators" hidden="false" targetId="bab3-f50d-3e5f-2f78" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="75"/></costs><selectionEntries><selectionEntry type="model" name="Contekar Cataphractii" id="c5a6-412e-7a64-f430" page="141" publicationId="3970-79bb-bdc6-9599"><profiles><profil