ule" targetId="f1e1-986f-c783-ca9e"/></infoLinks></selectionEntry><selectionEntry name="[LC] Darkwing Gunship" type="unit" id="d300-063f-f822-0b70" page="209" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="8e5b-d689-b6ac-eda3" name="fast" hidden="false" targetId="20ef-cd01-a8da-376e" primary="true"/><categoryLink id="f200-b505-44fd-6be5" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="225"/></costs><selectionEntries><selectionEntry type="model" name="Darkwing Gunship" id="ee1d-b2fd-cd12-07a6" page="209" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="fa73-9eba-62bc-e513" name="Darkwing Gunship" typeId="2fae-b053-3f78-e7b2"><characteristics><characteristic typeId="3614-4a2d-bffb-90e4" name="Move">18</characteristic><characteristic typeId="51fb-b7d9-aa59-863d" name="BS">4</characteristic><characteristic typeId="0ef8-a648-01d0-08ee" name="Front">12</characteristic><characteristic typeId="f150-c0dc-c192-9cb3" name="Side">12</characteristic><characteristic typeId="8d4e-2aea-fffc-d556" name="Rear">12</characteristic><characteristic typeId="a76c-83b1-602f-9e62" name="HP">4</characteristic><characteristic typeId="0c90-79e2-f768-e547" name="Transport Capacity">18</characteristic><characteristic typeId="e555-4aed-dfcc-c0b4" name="Unit Type">Vehicle (Flyer, Hover, Transport)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ca5c-2ac8-b44f-54a2"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ac97-4b7c-aa21-892a"/></constraints><entryLinks><entryLink id="87e3-0e0d-bfad-c0be" name="Two Wing (Front) Mounted Twin-Linked Lascannon" hidden="false" type="selectionEntry" targetId="190a-7b1b-644d-154a"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="640b-0566-2073-c8af"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="eeae-67ac-b9ed-1e31"/></constraints></entryLink><entryLink id="08c5-39e8-3edb-f9a1" name="Shroud Bombs" hidden="false" type="selectionEntry" targetId="5d4d-36b7-6bf5-fc92"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="65c4-5ace-28a1-60c0"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d760-8af4-b412-b864"/></constraints></entryLink></entryLinks><selectionEntryGroups><selectionEntryGroup id="2655-e279-1ce1-fb54" name="Hull (Front) Mounted weapon" hidden="false" collective="false" import="true" defaultSelectionEntryId="6a51-88d0-84cf-4e43"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6119-fce4-4fee-0647"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="328f-7492-8eda-7b53"/></constraints><entryLinks><entryLink id="6a51-88d0-84cf-4e43" name="Hull (Front) Mounted Twin-Linked Heavy Bolter" hidden="false" type="selectionEntry" targetId="8144-2f4c-4e73-20bb"/><entryLink id="3b6f-8251-dea1-4674" name="Hull (Front) Mounted Missile Launcher with Eclipse Missiles" hidden="false" type="selectionEntry" targetId="35aa-e93a-2950-f821"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="1c62-5a84-78a5-86ff" name="vehicle" hidden="false" targetId="e2b6-b770-784c-9e95" primary="false"/><categoryLink id="9ab9-55ff-7aa9-4670" name="transport" hidden="false" targetId="7b0a-a743-a8da-3a39" primary="false"/><categoryLink id="98a3-d83b-ac11-2bcf" name="flyer" hidden="false" targetId="4e84-2d57-4986-2b23" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="5196-57ba-7c29-0a75" name="Access Points" publicationId="3970-79bb-bdc6-9599" page="209" hidden="false"><description>Four access points; one on each side and one each at the front and rear.</description></rule><rule id="b9fc-e251-5d76-4962" name="Hull (Front) Mounted Vengeance Launcher" publicationId="3970-79bb-bdc6-9599" page="209" hidden="false"><description>Fires Eclipse Missiles (48&quot;, S4, AP5, Heavy 2, Large Blast (5&quot;), Blind, Shock Pulse).</description></rule><rule id="9013-cc9b-7af4-4f41" name="Kiavahran Repulsor Field" publicationId="3970-79bb-bdc6-9599" page="209" hidden="false"><description>All Shrouded Damage Mitigation rolls made by a unit with this Special Rule have their result improved by 1, granting Shrouded (6+) if it does not already have it. Additionally, when targeted by an enemy unit during the Interceptor Reaction, the enemy unit must pass an Initiative test; if it fails its Ballistic Skill is reduced by 1 for the Interceptor attacks.</description></rule></rules><infoLinks><infoLink id="ac3e-7eca-76a0-1806" name="Legiones Astartes (Raven Guard)" hidden="false" type="rule" targetId="9924-9434-baa1-0894"/><infoLink id="4f50-10e1-525b-98a2" name="Deep Strike" hidden="false" type="rule" targetId="f1e1-986f-c783-ca9e"/><infoLink id="f49e-8b01-9e34-39bb" name="Outflank" hidden="false" type="rule" targetId="bfbf-e75c-49a2-0285"/><infoLink id="d118-6dfa-d602-8955" name="Assault Vehicle" hidden="false" type="rule" targetId="aa61-11f6-2bb5-7c0e"/><infoLink id="8528-b829-cf79-f59c" name="Night Vision" hidden="false" type="rule" targetId="683e-b4f2-f032-d31b"/><infoLink id="54ed-b166-2803-2745" name="Power of the Machine Spirit" hidden="false" type="rule" targetId="5a93-13e0-809d-782a"/></infoLinks></selectionEntry><selectionEntry name="[LC] Omegon" type="unit" id="59d8-f88c-d6a9-290e" page="213" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="f945-7bba-3167-9d33" name="low" hidden="false" targetId="c658-dc6b-727b-c488" primary="true"/><categoryLink id="378e-3e70-f2a6-7c4c" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="450"/></costs><selectionEntries><selectionEntry type="model" name="Omegon" id="b1cb-f706-b6be-4122" page="213" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="d705-0b2e-9991-11c3" name="Omegon" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">8</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">7</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">7</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">6</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">6</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">6</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">6</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">6</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Primarch (Skirmish, Unique*)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="82e6-c271-f466-2ed2"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d8d9-0cdd-1033-01f1"/></constraints><entryLinks><entryLink id="b354-2fb0-4110-ee3d" name="The Basilisk's Raiment" hidden="false" type="selectionEntry" targetId="8fb6-d87e-f64b-e2f4"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ef7d-782c-dc67-3f8c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1aba-b72a-9907-03d3"/></constraints></entryLink><entryLink id="669e-4fc8-ed5f-41b8" name="The Whispering Death" hidden="false" type="selectionEntry" targetId="c84b-d571-3cda-2902"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f084-0a35-9eaf-26c2"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8a09-0dcf-527e-74f1"/></constraints></entryLink><entryLink id="7189-9d3e-a91c-1eb7" name="The Pale Sword" hidden="false" type="selectionEntry" targetId="7538-5359-9bbf-8ecb"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="87c7-ecd8-109a-d59b"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="98ca-c86f-b687-dec1"/></constraints></entryLink><entryLink id="eb83-c9a3-1852-8778" name="The Hydra's Spite" hidden="false" type="selectionEntry" targetId="cd02-ff0a-b828-134b"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d294-c5da-356a-8571"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4ae8-7f4e-0de5-4ec3"/></constraints></entryLink><entryLink id="cf51-913e-7b5d-bc47" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="95e0-b414-b145-cdf8"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d5fd-91d4-9382-e112"/></constraints></entryLink><entryLink id="3e26-e352-df9c-9bb5" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="402a-f458-1e65-a4ae"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e93c-c706-fcd3-1969"/></constraints></entryLink><entryLink id="58b2-a1ae-4b5e-55fa" name="Melta Bombs" hidden="false" type="selectionEntry" targetId="e55d-d31b-46a9-aeb6"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="eb5c-1234-a092-ab26"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b6c5-d7db-8e1b-f3e6"/></constraints></entryLink><entryLink id="e089-11f6-9174-9e43" name="Shroud Bombs" hidden="false" type="selectionEntry" targetId="5d4d-36b7-6bf5-fc92"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="fd74-3c6a-61c5-6ea5"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="98b2-f94c-c5a6-b8b0"/></constraints></entryLink><entryLink id="e106-d84d-a458-0dcb" name="Venom Spheres" hidden="false" type="selectionEntry" targetId="82f5-cca1-51a0-31dd"><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="37a9-8bb8-bbd8-fe43"/><constraint type="max" value="3" field="selections" scope="parent" shared="true" id="2ccf-8b9f-a82f-b3da"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="8251-90ba-9b94-ddae" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="ec00-4652-e6fd-a772" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="de7d-38f1-e5e1-e864" name="primarch" hidden="false" targetId="ad5f-31db-8bc7-5c46" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="c2fb-72f5-a2f0-3441" name="Marksman's Tutelage" publicationId="3970-79bb-bdc6-9599" page="213" hidden="false"><description>Whenever Omegon, or any member of a unit he has joined, makes any attacks as part of a Shooting Attack, the range of any weapons is not restricted or affected by the Night Fighting rules, Shroud Bombs, or any other Special Rule. No model may make Shrouded rolls to negate Wounds inflicted by Omegon's Shooting attacks.</description></rule><rule id="61dc-2682-7ab9-ac30" name="Walker in Shadow" publicationId="3970-79bb-bdc6-9599" page="213" hidden="false"><description>Grants Omegon Deep Strike, Scout and Infiltrate. These may be conferred to a single unit which must join Omegon via the chosen deployment method. On the turn such a unit enters the battle it gains Shrouded (4+) for the turn.</description></rule><rule id="bebb-e35b-822e-76ea" name="Unique*" publicationId="3970-79bb-bdc6-9599" page="213" hidden="false"><description>Omegon is Unique - an army that contains Alpharius may never also contain Omegon, and vice versa.</description></rule><rule id="310a-cade-be58-7a00" name="The Hydra's Spite" publicationId="3970-79bb-bdc6-9599" page="213" hidden="false"><description>See page 336 of the Liber Hereticus (profile not included in the Liber Centura).</description></rule></rules><infoLinks><infoLink id="bfb8-40d3-4921-7e50" name="Legiones Astartes (Alpha Legion)" hidden="false" type="rule" targetId="2a9e-be1f-d6c1-0ec4"/><infoLink id="7128-fb16-f94a-b352" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="9bcb-2695-7b2a-63eb" name="Adamantium Will (X+)" hidden="false" type="rule" targetId="4380-44a5-f01a-d964"><modifiers><modifier type="set" field="name" value="Adamantium Will (3+)"/></modifiers></infoLink><infoLink id="9a1c-d322-1ebb-4a0f" name="Pathfinder" hidden="false" type="rule" targetId="ec97-7aa8-49f5-b298"/><infoLink id="483c-94c7-474f-e547" name="Move Through Cover" hidden="false" type="rule" targetId="2b6f-bfec-759e-1746"/><infoLink id="110c-147f-4409-2424" name="Shrouded (X)" hidden="false" type="rule" targetId="10c3-fdb0-089f-ca65"><modifiers><modifier type="set" field="name" value="Shrouded (5+)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Legion Assault Support Squad" type="unit" id="c91c-8095-41e1-a730" page="28" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="fab9-3a4e-4145-5f9a" name="troops" hidden="false" targetId="9b5d-fac7-799b-d7e7" primary="true"/><categoryLink id="2301-10a2-f01b-da6d" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryL