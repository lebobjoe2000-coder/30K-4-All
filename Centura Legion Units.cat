ny other special rules or Mission rules in use – however, a model with this special rule may re-roll all failed Shrouded Damage Mitigation rolls.</description></rule></rules><infoLinks><infoLink id="95b8-3e42-4776-7663" name="Legiones Astartes (Salamanders)" hidden="false" type="rule" targetId="5b72-d9a6-92c3-4a1c"/><infoLink id="5bbc-4e62-fb6b-9e4c" name="Deep Strike" hidden="false" type="rule" targetId="f1e1-986f-c783-ca9e"/><infoLink id="eedf-1a7e-920a-d493" name="Outflank" hidden="false" type="rule" targetId="bfbf-e75c-49a2-0285"/><infoLink id="73d5-5720-dbdf-cfc4" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="8035-718c-9447-7903" name="Firing Protocols (X)" hidden="false" type="rule" targetId="32a3-f599-5c92-2945"><modifiers><modifier type="set" field="name" value="Firing Protocols (4)"/></modifiers></infoLink><infoLink id="a6ee-f3d2-94b0-8f99" name="Hit &amp; Run" hidden="false" type="rule" targetId="5986-e960-d432-affd"/></infoLinks></selectionEntry><selectionEntry name="[LC] Firestorm Bombard Squadron" type="unit" id="7084-dfc0-98f7-24ce" page="200" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="6529-0226-bfda-cd29" name="heavy_support" hidden="false" targetId="7031-469a-1aeb-eab0" primary="true"/><categoryLink id="8734-3fde-3d2f-0b83" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="20"/></costs><selectionEntries><selectionEntry type="model" name="Firestorm Bombard" id="1403-3e6d-bb9d-4fb8" page="200" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="8afc-f418-dca6-435b" name="Firestorm Bombard" typeId="2fae-b053-3f78-e7b2"><characteristics><characteristic typeId="3614-4a2d-bffb-90e4" name="Move">8</characteristic><characteristic typeId="51fb-b7d9-aa59-863d" name="BS">4</characteristic><characteristic typeId="0ef8-a648-01d0-08ee" name="Front">12</characteristic><characteristic typeI