-4fa2-0f4d" name="Searchlights" hidden="false" type="selectionEntry" targetId="4ae3-79b4-6051-505e"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="c070-5b62-b53c-8860" name="vehicle" hidden="false" targetId="e2b6-b770-784c-9e95" primary="false"/><categoryLink id="56cc-67fd-757e-eee7" name="transport" hidden="false" targetId="7b0a-a743-a8da-3a39" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="fc87-445c-64e3-ca86" name="Armour Interlock" publicationId="3970-79bb-bdc6-9599" page="120" hidden="false"><description>If a model with this Special Rule is in base contact with another model with this Special Rule, any friendly models within 3&quot; that claim an Intervening Model Cover Save from this model increase that save by one (6+ to 5+). Does not affect Cover Saves from other sources; cannot increase a Cover Save to better than 2+.</description></rule><rule id="8fa9-566d-de0e-ce6f" name="Access Points" publicationId="3970-79bb-bdc6-9599" page="120" hidden="false"><description>One Access Point on either side of the hull and one at the rear.</description></rule><rule id="48d1-8b96-f5be-9852" name="Dedicated Transport" publicationId="3970-79bb-bdc6-9599" page="120" hidden="false"><description>May be taken instead of a Legion Rhino Transport as a Dedicated Transport for any unit which may ordinarily select a Legion Rhino Transport.</description></rule></rules><infoLinks><infoLink id="a617-7b13-c195-4b1f" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><infoLink id="e5e2-900d-8a1e-8c42" name="Repair" hidden="false" type="rule" targetId="857b-1adc-8233-6c55"/><infoLink id="f66b-9e1b-763a-bd2e" name="Infantry Transport" hidden="false" type="rule" targetId="0c6b-9cc1-5801-3e83"/></infoLinks></selectionEntry><selectionEntry name="[LC] Targutai Yesugei" type="unit" 