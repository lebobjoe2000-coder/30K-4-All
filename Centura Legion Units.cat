nstraints></entryLink><entryLink id="e2eb-3bc8-f405-58b6" name="Graviton Maul" hidden="false" type="selectionEntry" targetId="b254-abfc-a57f-ab28"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="3b62-6a9f-7eeb-4cda"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5cdd-7241-5411-4cb8"/></constraints></entryLink><entryLink id="0e0f-e280-5063-3a6b" name="Twin-Linked Shrapnel Bolter" hidden="false" type="selectionEntry" targetId="1941-21b5-932c-74d6"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="4891-050c-4b24-bdfa"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a28b-3a34-b771-8a2b"/></constraints></entryLink><entryLink id="15e8-da4a-5189-2006" name="Frag Launchers" hidden="false" type="selectionEntry" targetId="768b-8315-4d0c-8eb7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="13d6-9741-d7c6-af0e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="de6d-ecc6-6828-6484"/></constraints></entryLink><entryLink id="897e-695a-d034-7e3f" name="Searchlights" hidden="false" type="selectionEntry" targetId="4ae3-79b4-6051-505e"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="80a8-817e-3c69-1a1e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0542-bd73-c3f9-c58c"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="084c-dc7a-277c-53d4" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="fd7f-fbfb-9a1a-bd18" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/><categoryLink id="64a2-d63c-838a-bbe1" name="dread" hidden="false" targetId="4280-4963-02b5-e31d" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="e1a0-fad6-6669-2600" name="Ferromantic Deflector (Wargear)" publicationId="3970-79bb-bdc6-9599" page="117" hidden="false"><description>A model with a ferromantic deflector gains a 5+ Invulnerable Save and any model with a ferromantic deflector and a Wounds Characteristic that suffers an unsaved Wound with the Instant Death special rule is not immediately removed as a casualty, but instead loses three Wounds instead of one for each unsaved Wound with the Instant Death special rule inflicted on it. In addition, when a model with a ferromantic deflector loses its last Wound or Hull Point, but before it is removed as a casualty or replaced with a Wreck, all models both friendly and enemy within D6&quot; suffer an automatic Hit at Str 6, AP -.</description></rule><rule id="caea-2bad-f72b-3c19" name="Two time-frames" publicationId="3970-79bb-bdc6-9599" page="117" hidden="false"><description>An army that contains Berossus, Interred may never also contain Warsmith Berossus, and vice versa.</description></rule><rule id="2fca-61c8-6ad6-88c6" name="Dedicated Transport" publicationId="3970-79bb-bdc6-9599" page="117" hidden="false"><description>May take a Legion Dreadnought Drop Pod as a Dedicated Transport (does not use a Force Organisation slot; points still paid).</description></rule><rule id="01b5-d63e-5f65-2fcb" name="Graviton Maul" publicationId="3970-79bb-bdc6-9599" page="117" hidden="false"><description>The Graviton Maul has an in-built Twin-Linked Shrapnel Bolter.</description></rule></rules><infoLinks><infoLink id="6bc8-ffe9-216e-4442" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><infoLink id="78c3-b584-7682-1419" name="Traitor" hidden="false" type="rule" targetId="eff2-8b0e-21da-2f0d"/><infoLink id="5027-e719-ce51-bd00" name="Support Squad" hidden="false" type="rule" targetId="768e-56d6-ca52-24ae"/><infoLink id="d524-f5bc-9b86-0534" name="Reaping Blow (X)" hidden="false" type="rule" targetId="bd8c-4f52-d682-1b40"><modifiers><modifier type="set" field="name" value="Reaping Blow (1)"/></modifiers></infoLink></infoLinks></selectionEntry><selectionEntry name="[LC] Warsmith Toramino" type="unit" id="d6b2-f225-e04c-4fa8" page="118" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="d291-5422-9b64-8542" name="hq" hidden="false" targetId="4f85-eb33-30c9-8f51" primary="true"/><categoryLink id="b66a-2ac3-4080-2589" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="160"/></costs><selectionEntries><selectionEntry type="model" name="Warsmith Toramino" id="4bd0-0af8-2d94-8f58" page="118" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="5c4b-7e30-1b6d-e49e" name="Warsmith Toramino" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">6</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">5</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">3</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">5</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">4</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">10</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry (Character, Unique)</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e772-d692-95b7-2880"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="825e-648b-bd36-e8cd"/></constraints><entryLinks><entryLink id="6645-f847-aca6-0e26" name="Bolt Pistol" hidden="false" type="selectionEntry" targetId="e5ae-6872-37aa-8600"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="9697-ff36-0e17-a9c7"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9a80-10f4-53f7-a701"/></constraints></entryLink><entryLink id="faf0-e532-af3d-5cd9" name="Power Sword" hidden="false" type="selectionEntry" targetId="a3cd-aa97-a148-2309"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="03c1-d054-0ed6-524e"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0400-06fb-3df3-c495"/></constraints></entryLink><entryLink id="37e5-797a-1464-53ef" name="Phosphex Bomb" hidden="false" type="selectionEntry" targetId="4188-13ff-cb03-109e"><constraints><constraint type="min" value="3" field="selections" scope="parent" shared="true" id="34b4-7712-17c3-f66b"/><constraint type="max" value="3" field="selections" scope="parent" shared="true" id="4f10-4beb-32bc-3801"/></constraints></entryLink><entryLink id="08f7-6e6c-ebc1-c31c" name="Artificer Armour" hidden="false" type="selectionEntry" targetId="583e-62cb-53f1-f952"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7461-dfaa-a56f-6b9f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a9dc-7ceb-8e42-0450"/></constraints></entryLink><entryLink id="a655-f697-fb7b-89a4" name="Iron Halo" hidden="false" type="selectionEntry" targetId="b081-bf3c-f43d-4bd5"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="a631-ca22-261e-3a1a"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9fed-773d-36b4-c678"/></constraints></entryLink><entryLink id="017d-6224-bf47-6c83" name="Cognis-Signum" hidden="false" type="selectionEntry" targetId="93b3-2d66-f7a3-be42"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="df9b-3fea-45b9-9332"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="949c-f7ca-0774-d4cd"/></constraints></entryLink><entryLink id="84a4-4563-6f32-6e6d" name="Cortex Controller" hidden="false" type="selectionEntry" targetId="2fda-455f-d34d-97e0"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7162-119d-6225-44cc"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3e78-ae06-b6ce-8706"/></constraints></entryLink><entryLink id="c6dc-bdc9-5bcc-aac1" name="Servo-Arm" hidden="false" type="selectionEntry" targetId="4168-fc85-8912-7188"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2fab-3204-c275-36a8"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7f5b-1130-ad4d-96eb"/></constraints></entryLink><entryLink id="154a-6355-0eb8-c708" name="Frag Grenades" hidden="false" type="selectionEntry" targetId="cf9c-327b-3449-00d7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="288b-0ee0-496d-a2ef"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df10-f10e-f866-d135"/></constraints></entryLink><entryLink id="a81c-a37e-b412-7d4d" name="Krak Grenades" hidden="false" type="selectionEntry" targetId="99df-2421-acf7-a5ad"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cf17-d985-dcee-974f"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7dfd-a289-de04-b8f7"/></constraints></entryLink></entryLinks><categoryLinks><categoryLink id="743f-5d6d-ea49-dceb" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/><categoryLink id="669d-e028-d6df-117b" name="character" hidden="false" targetId="f75a-d5c1-59ba-5c5a" primary="false"/><categoryLink id="3eb8-4dab-7f40-43f7" name="indep" hidden="false" targetId="4f07-3d45-4f28-a0c6" primary="false"/><categoryLink id="fce6-c8d2-0843-743d" name="unique" hidden="false" targetId="aa94-5c65-d1f1-46a4" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="b638-5037-9edd-11f6" name="Warlord: Master of the Stor-Bezashk" publicationId="3970-79bb-bdc6-9599" page="118" hidden="false"><description>If chosen as Warlord he has Master of the Stor-Bezashk and may not select another. Friendly models from his Detachment with Legiones Astartes (Iron Warriors) and the Bombard Unit Sub-type gain +1 Ballistic Skill when making a Shooting attack. The army gains an additional reaction in the Opposing Player's Shooting phase while he has not been removed as a casualty.</description></rule><rule id="68a4-f9c2-d193-e317" name="Warsmith and Siege Breaker" publicationId="3970-79bb-bdc6-9599" page="118" hidden="false"><description>For the purposes of Rites of War and mandatory unit selections only, Warsmith Toramino counts as a Warsmith and a Siege Breaker.</description></rule></rules><infoLinks><infoLink id="6c10-2c28-9aba-3016" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><infoLink id="6969-0f27-2912-7c2f" name="Master of the Legion" hidden="false" type="rule" targetId="c772-87ea-d49c-c7ba"/><infoLink id="8169-fb79-36ff-f948" name="Master of Automata" hidden="false" type="rule" targetId="8eef-f84b-37cb-554b"/><infoLink id="5c58-9fd6-5164-69b9" name="Battlesmith (X)" hidden="false" type="rule" targetId="5d57-4d02-1e36-4a82"><modifiers><modifier type="set" field="name" value="Battlesmith (3+)"/></modifiers></infoLink><infoLink id="aeeb-49d5-43ab-a0c8" name="Traitor" hidden="false" type="rule" targetId="eff2-8b0e-21da-2f0d"/></infoLinks></selectionEntry><selectionEntry name="[LC] Dominator Tartaros Cohort" type="unit" id="8d93-1ecb-fede-c752" page="119" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="39a4-c504-483a-2563" name="elites" hidden="false" targetId="7aee-565f-b0ae-294e" primary="true"/><categoryLink id="3c34-f1ae-81ab-2969" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/><categoryLink id="ec5f-8f54-3a87-3ad5" name="terminators" hidden="false" targetId="bab3-f50d-3e5f-2f78" primary="false"/></categoryLinks><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="25"/></costs><selectionEntries><selectionEntry type="model" name="Dominator Tartaros" id="66fc-d9fb-a744-d6be" page="119" publicationId="3970-79bb-bdc6-9599"><profiles><profile id="f41a-336c-6264-8d9f" name="Dominator Tartaros" typeId="4bb2-cb95-e6c8-5a21"><characteristics><characteristic typeId="893e-2d76-8f04-44e5" name="Move">7</characteristic><characteristic typeId="cc42-7ed5-7092-5c84" name="WS">5</characteristic><characteristic typeId="74ae-c840-0036-d244" name="BS">4</characteristic><characteristic typeId="e478-41d4-a092-48a8" name="S">4</characteristic><characteristic typeId="c32b-5fdd-3fbe-9b1f" name="T">4</characteristic><characteristic typeId="57ee-1126-32a9-5672" name="W">2</characteristic><characteristic typeId="62d3-22d7-2d49-52dc" name="I">4</characteristic><characteristic typeId="f111-2ce5-dd12-d6b0" name="A">2</characteristic><characteristic typeId="e8a6-1da9-d384-8727" name="Ld">9</characteristic><characteristic typeId="e593-6b3c-f169-04f0" name="Save">2+</characteristic><characteristic typeId="ddd7-6f5c-a939-b69e" name="Unit Type">Infantry</characteristic></characteristics></profile></profiles><constraints><constraint type="min" value="5" field="selections" scope="parent" shared="true" id="b003-8f18-67a9-a8bf"/><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="9deb-9878-1c0d-f83d"/></constraints><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="40"/></costs><entryLinks><entryLink id="8f15-03ec-45b1-4eb4" name="Tartaros Terminator Armour" hidden="false" type="selectionEntry" targetId="f850-d0af-8663-ccac"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2f94-1d2d-789a-90d5"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0473-a264-8e30-4a25"/></constraints></entryLink></entryLinks><selectionEntryGroups><selectionEntryGroup id="d14d-d6f9-2ab7-aca5" name="Combi-Bolter - heavy options limited to 1 model per 5 in the unit" hidden="false" collective="false" import="true" defaultSelectionEntryId="e37e-8424-85e7-c67a"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="abd9-dbfe-2515-d23b"/><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="7a18-9b25-d399-8612"/></constraints><entryLinks><entryLink id="e37e-8424-85e7-c67a" name="Combi-Bolter" hidden="false" type="selectionEntry" targetId="a498-c66f-9eb7-ca9a"/><entryLink id="0cb7-137f-b5e3-b5d7" name="Heavy Flamer" hidden="false" type="selectionEntry" targetId="5507-b432-3b4c-df12"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink><entryLink id="94e6-8f19-8d2e-f29b" name="Reaper Autocannon" hidden="false" type="selectionEntry" targetId="b87f-48de-6ced-043b"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="15"/></costs></entryLink><entryLink id="98df-66ed-c385-599a" name="Multi-Melta" hidden="false" type="selectionEntry" targetId="9332-3834-cf3a-56b4"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="25"/></costs></entryLink><entryLink id="dcb2-ab5b-c7a7-26a8" name="Minor Combi-Weapon" hidden="false" type="selectionEntry" targetId="605e-1b86-ca08-9226"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="5"/></costs></entryLink><entryLink id="fc7b-caef-d8a1-656c" name="Magna Combi-Weapon" hidden="false" type="selectionEntry" targetId="e5b1-83e5-7272-a59e"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup><selectionEntryGroup id="a73d-0770-91c9-616f" name="Exchange Thunder Hammer for" hidden="false" collective="false" import="true" defaultSelectionEntryId="7c27-4833-d93d-1a7f"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="1679-2470-b07c-4343"/><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="cb2c-47db-8c17-d188"/></constraints><entryLinks><entryLink id="7c27-4833-d93d-1a7f" name="Thunder Hammer" hidden="false" type="selectionEntry" targetId="838c-4002-713d-d7c6"/><entryLink id="b8ff-baa0-9485-e1bd" name="Chainfist" hidden="false" type="selectionEntry" targetId="7347-c5b1-5da3-a78f"><costs><cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="15"/></costs></entryLink></entryLinks></selectionEntryGroup></selectionEntryGroups><categoryLinks><categoryLink id="f8cd-26b1-6e44-0f58" name="infantry" hidden="false" targetId="8b4f-bfe2-ce7b-f1b1" primary="false"/></categoryLinks></selectionEntry></selectionEntries><rules><rule id="dba3-31c0-e629-f821" name="Those Once Honoured" publicationId="3970-79bb-bdc6-9599" page="119" hidden="false"><description>An Iron Warriors Dominator Cohort may be selected as a Retinue Squad in a Detachment that includes Perturabo, instead of as an Elites choice. A unit selected as a ‘Retinue Squad’ must have Perturabo as the Iron Warriors Dominator Cohort’s Leader for the purposes of this special rule. An Iron Warriors Dominator Cohort selected as a Retinue Squad does not use up a Force Organisation slot and is considered part of the same unit as Perturabo. An Iron Warriors Dominator Cohort selected as a Retinue Squad must be deployed with Perturabo as part of the unit and Perturabo may not voluntarily leave the Retinue Squad during play. All models in an Iron Warriors Dominator Cohort selected in this manner lose the Hatred (Automata) and instead gain the Feel No Pain (6+) special rule. In addition, if an army includes an Iron Warriors Dominator Cohort selected as a Retinue Squad for Perturabo, then the army may not include any ‘Iron Circle’ Domitar-ferrum class Battle-automata Maniples.</description></rule><rule id="7209-94e6-8b75-e890" name="Selection limit" publicationId="3970-79bb-bdc6-9599" page="119" hidden="false"><description>You may only include either a single Dominator Cohort or Dominator Tartaros Cohort in your army (0-1).</description></rule><rule id="d242-baaa-af6d-b5d9" name="Dedicated Transport" publicationId="3970-79bb-bdc6-9599" page="119" hidden="false"><description>May take a Legion Land Raider Proteus Carrier (unit of no more than 5 models) or a Legion Land Raider Spartan (unit of any size) as a Dedicated Transport; no extra Force Organisation slot, points still paid.</description></rule></rules><infoLinks><infoLink id="8648-7cc0-5406-f23c" name="Legiones Astartes (Iron Warriors)" hidden="false" type="rule" targetId="c77b-f3fc-5dc8-1330"/><infoLink id="1fbd-aaa4-c93a-af9a" name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d"/><infoLink id="9ff5-6857-7087-3e2b" name="Stubborn" hidden="false" type="rule" targetId="7989-1f2c-a43d-82ae"/><infoLink id="5a92-b865-d298-b075" name="Hatred (X)" hidden="false" type="rule" targetId="dc0b-fe69-6b71-e0a4"><modifiers><modifier type="set" field="name" value="Hatred (Automata)"/></modifiers></infoLink><infoLink id="d748-c772-c696-7767" name="Bulky (X)" hidden="false" type="rule" targetId="676c-7b75-4b6f-9405"><modifiers><modifier type="set" field="name" value="Bulky (2)"/></modifiers></infoLink><infoLink id="aef2-59b5-338e-e727" name="Chosen Warriors" hidden="false" type="rule" targetId="13d1-9270-6539-08ed"/></infoLinks></selectionEntry><selectionEntry name="[LC] Rhino Castellan" type="unit" id="d239-c268-ab06-9c5e" page="120" publicationId="3970-79bb-bdc6-9599"><categoryLinks><categoryLink id="18f9-d5f1-4165-6fb0" name="unit" hidden="false" targetId="36c3-e85e-97cc-c503" primary="false"/></categoryLinks><costs><cost name="Pts" t